# cline-sandbox-proxy: sandbox の外向き通信を、許可リストのドメインだけに絞る HTTP(S) プロキシ
#
# 使い方は README の「ネットワーク許可モード」を参照。scripts/proxy.sh が実行時に、設定（tinyproxy.conf）と
# 許可リストを読み取り専用でマウントする（変更にイメージの再ビルドは要らない）。
# ここでコピーする tinyproxy.conf は、マウントせずに起動したときの既定値。
FROM docker.io/library/alpine:3

RUN apk add --no-cache tinyproxy \
    && tinyproxy -v

COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf

EXPOSE 8888
# -d: フォアグラウンドで動かす（アクセスログは tinyproxy.conf の LogFile に出る）
ENTRYPOINT ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
