FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV OLLAMA_HOST=127.0.0.1:11434

# 1〜4. 基本ツール・Node.js・Ollama・Cline CLI・Codex CLI（検証済みの版は install.sh に固定）
#    SmolLM 135M も事前に取得する（方式B: 完全オフライン対応）。
#    native モード（scripts/launcher.py）も同じ install.sh を使う
COPY scripts/install.sh scripts/bun-fetch-no-timeout.js /tmp/install/
RUN bash /tmp/install/install.sh --with-smollm && rm -rf /tmp/install

# 4.1 Cline CLI (Bun) の fetch 既定 300 秒タイムアウトを Ollama 宛てだけ外す preload（install.sh が配置）
#     詳細は docs/results/CPU_TIMEOUT_RESULT.md。hub daemon にも効かせるため ENV で全プロセスに渡す
ENV BUN_OPTIONS="--preload /usr/local/lib/cline/bun-fetch-no-timeout.js"
# Cline の自動更新（起動のたびに npm から最新版を入れる）を止め、検証済みの版に固定する
ENV CLINE_NO_AUTO_UPDATE=1

# 5. workspace ディレクトリの作成
RUN mkdir -p /workspace

# 6. entrypoint スクリプトの配置
COPY scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
