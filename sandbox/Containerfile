FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV OLLAMA_HOST=127.0.0.1:11434

# 1. 必要な基本ツールのインストール
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    procps \
    tar \
    zstd \
    && rm -rf /var/lib/apt/lists/*

# 2. Node.js 22 (LTS) のインストール
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version

# 3. Ollama のインストール & SmolLM 135M の事前キャッシュ（方式B: 完全オフライン対応）
#    （検証済みの版に固定。大きいのでエージェントより先の層に置く）
ARG OLLAMA_VERSION=0.34.2
RUN curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION="${OLLAMA_VERSION}" sh \
    && ollama --version \
    && ollama serve & \
    until curl -s http://127.0.0.1:11434/api/tags > /dev/null 2>&1; do sleep 1; done \
    && ollama pull smollm:135m \
    && pkill ollama \
    && sleep 2

# 4. Cline CLI / Codex CLI のインストール（検証済みの版に固定）
ARG CLINE_VERSION=3.0.64
ARG CODEX_VERSION=0.156.1
RUN npm install -g "cline@${CLINE_VERSION}" "@openai/codex@${CODEX_VERSION}" \
    && cline --version \
    && codex --version

# 4.1 Cline CLI (Bun) の fetch 既定 300 秒タイムアウトを Ollama 宛てだけ外す preload
#     詳細は cpu-timeout/RESULT.md。hub daemon にも効かせるため ENV で全プロセスに渡す
COPY scripts/bun-fetch-no-timeout.js /usr/local/lib/cline/bun-fetch-no-timeout.js
ENV BUN_OPTIONS="--preload /usr/local/lib/cline/bun-fetch-no-timeout.js"

# 5. workspace ディレクトリの作成
RUN mkdir -p /workspace

# 6. entrypoint スクリプトの配置
COPY scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
